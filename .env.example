# AIapi 部署配置（docker compose 自动读取本文件）。
# 全部留空即可正常部署：启动后打开面板，首次会提示注册管理员账号。
#
# 变量改名为 AIAPI_*；改名前的 AGENT2API_* 写法仍然可读（取值优先级：
# AIAPI_* > AGENT2API_* > 1.x 的 WORKBUDDY_*），已有部署不必改。

# 面板管理员：留空 = 启动后在面板注册（推荐）；填了 = 跳过注册，用这里的账号登录。
AIAPI_ADMIN_USER=
# 密码直接填明文（启动时自动转成 bcrypt 哈希，库里只存哈希）。
AIAPI_ADMIN_PASSWORD=

# 面板分端口：留空 = 面板与网关同端口；填了（如 3066）= 面板单独监听该端口，
# 主端口只保留 /v1 网关 —— 公网只映射主端口，即可把面板留在内网。
AIAPI_PANEL_PORT=

# 登录页人机验证组件环境变量，默认为0关闭，1为开启
AIAPI_CAPTCHA_ENABLED=0
